		(uuid "ad97874c-dd14-51e1-9df5-79b6e6297d35")
	)
	(text "4 · MECHANICS"
		(exclude_from_sim no)
		(at 153.5 141.5 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "53daff45-dc70-5592-871e-d4cb64edafbe")
	)
	(text "42.3 x 42.3 mm board on the back of the NEMA 17, M3 holes on the\n31 mm motor pattern (long M3 screws through the motor body).\nU1 is centred on the shaft axis, on the side facing the motor.\nMagnet: diametric 6 x 2.5 mm (or 8 x 3), glued to the rear shaft end.\nAir gap magnet to chip top: 0.5 - 3 mm.\nOnly U1, C1, C2 and JP1 are on the motor side (max 1.75 mm high)."
		(exclude_from_sim no)
		(at 155 152 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8e1f828e-ff8f-54cc-9c43-5eb74605fa78")
	)
